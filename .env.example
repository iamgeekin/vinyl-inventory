# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These identify the project and are visible in the published site; firestore.rules protects the data.
# Leave them empty to keep records on each device, without syncing.
# The invite phrase does NOT belong here or anywhere in this repository.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
